{
  "openapi": "3.0.0",
  "info": {
    "title": "Wine Quality Prediction API",
    "version": "1.0.0",
    "description": "API for predicting wine quality based on physicochemical properties",
    "contact": {
      "name": "API Support",
      "email": "support@winequality.ai"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5001",
      "description": "Development server"
    },
    {
      "url": "https://api.winequality.ai/v1",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "predictions",
      "description": "Wine quality prediction operations"
    }
  ],
  "paths": {
    "/predict": {
      "post": {
        "tags": ["predictions"],
        "summary": "Predict wine quality score",
        "description": "Returns a quality score between 0-10 based on wine's chemical properties",
        "operationId": "predictQuality",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictionRequest"
              },
              "examples": {
                "sampleRequest": {
                  "value": {
                    "fixed acidity": 7.4,
                    "volatile acidity": 0.7,
                    "citric acid": 0,
                    "residual sugar": 1.9,
                    "chlorides": 0.076,
                    "free sulfur dioxide": 11,
                    "total sulfur dioxide": 34,
                    "density": 0.9978,
                    "pH": 3.51,
                    "sulphates": 0.56,
                    "alcohol": 9.4
                  }
                }

              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful prediction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionResponse"
                },
                "examples": {
                  "success": {
                    "value": {
                      "prediction": 6,
                      "status": "success"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalidInput": {
                    "value": {
                      "error": "Expected 11 features, got 10",
                      "status": "error"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PredictionRequest": {
        "type": "object",
        "required": [
          "fixed acidity", "volatile acidity", "citric acid",
          "residual sugar", "chlorides", "free sulfur dioxide",
          "total sulfur dioxide", "density", "pH", "sulphates", "alcohol"
        ],
        "properties": {
          "fixed acidity": {"type": "number"},
          "volatile acidity": {"type": "number"},
          "citric acid": {"type": "number"},
          "residual sugar": {"type": "number"},
          "chlorides": {"type": "number"},
          "free sulfur dioxide": {"type": "number"},
          "total sulfur dioxide": {"type": "number"},
          "density": {"type": "number"},
          "pH": {"type": "number"},
          "sulphates": {"type": "number"},
          "alcohol": {"type": "number"}
        }
      },
      "PredictionResponse": {
        "type": "object",
        "properties": {
          "prediction": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10,
            "description": "Predicted quality score (0-10)"
          },
          "status": {
            "type": "string",
            "enum": ["success"]
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error description"
          },
          "status": {
            "type": "string",
            "enum": ["error"]
          }
        }
      }
    }
  }
}
